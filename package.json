{
	"name": "dev",
	"version": "0.0.0",
	"private": true,
	"homepage": "https://prncss-xyz.github.io/dev/",
	"repository": {
		"type": "git",
		"url": "https://github.com/prncss-xyz/dev.git"
	},
	"type": "module",
	"scripts": {
		"dev": "waku dev --host ${HOST:-127.0.0.1} --port ${PORT:-6006}",
		"core:build": "vp run build",
		"dev:start": "vp run start",
		"typegen": "waku router typegen",
		"prepare": "git config --local --get core.hooksPath >/dev/null 2>&1 || vp config",
		"dev:test:units": "vp run test:units --watch",
		"check:test:units": "vp run test:units",
		"check:test:e2e": "playwright test",
		"check:test:e2e:ui": "playwright test --ui",
		"check:test:e2e:report": "playwright show-report",
		"check:tsc": "vp run tsc:changed",
		"check:knip": "knip --production --cache",
		"fix": "vp check --fix",
		"dev:storybook": "storybook dev",
		"build:storybook": "storybook build"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
