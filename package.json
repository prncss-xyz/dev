		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"unified": "^11.0.5",
		"waku": "1.0.0-rc.2"
